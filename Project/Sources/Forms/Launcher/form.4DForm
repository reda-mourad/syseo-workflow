{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowTitle": "Accueil",
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"events": [
		"onMouseEnter",
		"onMouseLeave",
		"onLoad",
		"onUnload",
		"onClick"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"Rectangle": {
					"type": "rectangle",
					"top": 0,
					"left": 0,
					"width": 229,
					"height": 61,
					"fill": "#ABABAB",
					"stroke": "transparent"
				},
				"Button": {
					"type": "button",
					"text": "Button",
					"top": 0,
					"left": 0,
					"width": 55,
					"height": 27,
					"events": [
						"onClick"
					],
					"shortcutAccel": false,
					"shortcutControl": false,
					"shortcutShift": false,
					"shortcutAlt": false,
					"shortcutKey": "[Esc]",
					"visibility": "hidden"
				},
				"bgWorkspaceButton": {
					"type": "rectangle",
					"left": 15,
					"top": 15,
					"width": 200,
					"height": 40,
					"stroke": "#c0c0c0",
					"fill": "#C1F3A0"
				},
				"btnWorkspace": {
					"type": "button",
					"style": "custom",
					"borderStyle": "none",
					"text": "Tâches et messagerie",
					"left": 15,
					"top": 15,
					"width": 200,
					"height": 40,
					"events": [
						"onMouseEnter",
						"onMouseLeave",
						"onClick"
					],
					"fontWeight": "bold"
				},
				"bgWorkspaceBadge": {
					"type": "oval",
					"left": 200,
					"top": 3,
					"width": 24,
					"height": 24,
					"stroke": "#B71C1C",
					"fill": "#E53935"
				},
				"inputWorkspaceBadge": {
					"type": "input",
					"left": 200,
					"top": 7,
					"width": 24,
					"height": 20,
					"dataSource": "Form:C1466.handler.combinedBadge",
					"enterable": false,
					"focusable": false,
					"fill": "transparent",
					"borderStyle": "none",
					"stroke": "#FFFFFF",
					"fontSize": 12,
					"fontWeight": "bold",
					"textAlign": "center",
					"horizontalPadding": 0,
					"verticalPadding": 0
				}
			}
		}
	],
	"method": "method.4dm",
	"geometryStamp": 52,
	"editor": {
		"groups": {
			"Group": [
				"bgWorkspaceButton",
				"btnWorkspace"
			],
			"Group1": [
				"bgWorkspaceBadge",
				"inputWorkspaceBadge"
			]
		},
		"activeView": "View 2",
		"defaultView": "View 1",
		"views": {
			"View 1": {},
			"View 2": {
				"objects": [
					"Rectangle"
				]
			}
		}
	},
	"rightMargin": 0,
	"bottomMargin": 0
}