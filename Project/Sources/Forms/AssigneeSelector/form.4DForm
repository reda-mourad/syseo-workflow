{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"rightMargin": 20,
	"bottomMargin": 20,
	"windowTitle": "Sélection des assignés",
	"destination": "detailScreen",
	"events": [
		"onLoad",
		"onDataChange",
		"onClick"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"bgSearch": {
					"type": "rectangle",
					"left": 20,
					"top": 25,
					"width": 760,
					"height": 34,
					"stroke": "#c0c0c0",
					"sizingX": "grow"
				},
				"inputSearch": {
					"type": "input",
					"left": 30,
					"top": 33,
					"width": 740,
					"height": 18,
					"placeholder": "Rechercher par nom ou initiales",
					"dataSource": "Form:C1466.handler.searchText",
					"events": [
						"onDataChange"
					],
					"fill": "transparent",
					"borderStyle": "none",
					"sizingX": "grow"
				},
				"lbAssignees": {
					"type": "listbox",
					"left": 20,
					"top": 75,
					"width": 760,
					"height": 320,
					"events": [
						"onClick"
					],
					"listboxType": "collection",
					"dataSource": "Form:C1466.handler.assignees",
					"selectionMode": "single",
					"hideSystemHighlight": true,
					"singleClickEdit": true,
					"sortable": false,
					"showHeaders": true,
					"headerHeight": "30px",
					"rowHeight": "26px",
					"scrollbarHorizontal": "automatic",
					"scrollbarVertical": "automatic",
					"sizingX": "grow",
					"sizingY": "grow",
					"resizingMode": "legacy",
					"columns": [
						{
							"header": {
								"text": "",
								"name": "headerAssigneeSelected"
							},
							"name": "columnAssigneeSelected",
							"width": 44,
							"dataSource": "This:C1470.selected",
							"dataSourceTypeHint": "boolean",
							"controlType": "checkbox",
							"events": [
								"onDataChange"
							],
							"enterable": true,
							"textAlign": "center",
							"horizontalPadding": 5,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer1"
							}
						},
						{
							"header": {
								"text": "Initiales",
								"name": "headerAssigneeInitials"
							},
							"name": "columnAssigneeInitials",
							"width": 78,
							"dataSource": "This:C1470.initials",
							"enterable": false,
							"horizontalPadding": 6,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer2"
							}
						},
						{
							"header": {
								"text": "Profil",
								"name": "headerAssigneeProfile"
							},
							"name": "columnAssigneeProfile",
							"width": 150,
							"dataSource": "This:C1470.profile",
							"enterable": false,
							"horizontalPadding": 6,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer3"
							}
						},
						{
							"header": {
								"text": "Nom",
								"name": "headerAssigneeName"
							},
							"name": "columnAssigneeName",
							"width": 433,
							"dataSource": "This:C1470.name",
							"enterable": false,
							"horizontalPadding": 6,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer4"
							}
						}
					]
				},
				"bgCancel": {
					"type": "rectangle",
					"left": 360,
					"top": 415,
					"width": 200,
					"height": 30,
					"stroke": "#c0c0c0",
					"fill": "#E5E5E5",
					"sizingX": "move",
					"sizingY": "move"
				},
				"btnCancel": {
					"type": "button",
					"style": "custom",
					"borderStyle": "none",
					"text": "Annuler",
					"action": "cancel",
					"left": 360,
					"top": 415,
					"width": 200,
					"height": 30,
					"sizingX": "move",
					"sizingY": "move"
				},
				"bgSelect": {
					"type": "rectangle",
					"left": 580,
					"top": 415,
					"width": 200,
					"height": 30,
					"stroke": "#c0c0c0",
					"fill": "#C1F3A0",
					"sizingX": "move",
					"sizingY": "move"
				},
				"btnSelect": {
					"type": "button",
					"style": "custom",
					"borderStyle": "none",
					"text": "Sélectionner",
					"action": "accept",
					"left": 580,
					"top": 415,
					"width": 200,
					"height": 30,
					"sizingX": "move",
					"sizingY": "move"
				}
			}
		}
	],
	"geometryStamp": 9,
	"method": "method.4dm",
	"editor": {
		"groups": {
			"Group": [
				"bgCancel",
				"btnCancel"
			],
			"Group1": [
				"bgSelect",
				"btnSelect"
			]
		},
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed"
}