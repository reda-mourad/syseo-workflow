{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"rightMargin": 20,
	"bottomMargin": 20,
	"windowTitle": "Sélection des catégories",
	"destination": "detailScreen",
	"events": [
		"onLoad",
		"onDataChange",
		"onClick"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"bgSearch": {
					"type": "rectangle",
					"left": 18,
					"top": 20,
					"width": 420,
					"height": 34,
					"stroke": "#c0c0c0",
					"sizingX": "grow"
				},
				"inputSearch": {
					"type": "input",
					"left": 28,
					"top": 28,
					"width": 400,
					"height": 18,
					"placeholder": "Rechercher une catégorie",
					"dataSource": "Form:C1466.handler.searchText",
					"events": [
						"onDataChange"
					],
					"fill": "transparent",
					"borderStyle": "none",
					"sizingX": "grow"
				},
				"lbCategories": {
					"type": "listbox",
					"left": 18,
					"top": 70,
					"width": 420,
					"height": 320,
					"events": [
						"onClick"
					],
					"listboxType": "collection",
					"dataSource": "Form:C1466.handler.categories",
					"selectionMode": "single",
					"hideSystemHighlight": true,
					"singleClickEdit": true,
					"sortable": false,
					"metaSource": "Form:C1466.handler.categoryMeta(This:C1470)",
					"showHeaders": true,
					"headerHeight": "30px",
					"rowHeight": "26px",
					"scrollbarHorizontal": "automatic",
					"scrollbarVertical": "automatic",
					"sizingX": "grow",
					"sizingY": "grow",
					"resizingMode": "legacy",
					"columns": [
						{
							"header": {
								"text": "",
								"name": "headerCategorySelected"
							},
							"name": "columnCategorySelected",
							"width": 44,
							"dataSource": "This:C1470.selected",
							"dataSourceTypeHint": "boolean",
							"controlType": "checkbox",
							"events": [
								"onDataChange"
							],
							"enterable": true,
							"textAlign": "center",
							"horizontalPadding": 5,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer1"
							}
						},
						{
							"header": {
								"text": "Catégorie",
								"name": "headerCategoryName"
							},
							"name": "columnCategoryName",
							"dataSource": "This:C1470.label",
							"enterable": false,
							"horizontalPadding": 6,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer2"
							}
						}
					]
				},
				"bgCancel": {
					"type": "rectangle",
					"left": 18,
					"top": 410,
					"width": 200,
					"height": 30,
					"stroke": "#c0c0c0",
					"fill": "#E5E5E5",
					"sizingX": "move",
					"sizingY": "move"
				},
				"btnCancel": {
					"type": "button",
					"style": "custom",
					"borderStyle": "none",
					"text": "Annuler",
					"action": "cancel",
					"left": 18,
					"top": 410,
					"width": 200,
					"height": 30,
					"sizingX": "move",
					"sizingY": "move"
				},
				"bgSelect": {
					"type": "rectangle",
					"left": 238,
					"top": 410,
					"width": 200,
					"height": 30,
					"stroke": "#c0c0c0",
					"fill": "#C1F3A0",
					"sizingX": "move",
					"sizingY": "move"
				},
				"btnSelect": {
					"type": "button",
					"style": "custom",
					"borderStyle": "none",
					"text": "Sélectionner",
					"action": "accept",
					"left": 238,
					"top": 410,
					"width": 200,
					"height": 30,
					"sizingX": "move",
					"sizingY": "move"
				}
			}
		}
	],
	"geometryStamp": 14,
	"method": "method.4dm",
	"editor": {
		"groups": {
			"Group": [
				"bgCancel",
				"btnCancel"
			],
			"Group1": [
				"bgSelect",
				"btnSelect"
			]
		},
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed"
}