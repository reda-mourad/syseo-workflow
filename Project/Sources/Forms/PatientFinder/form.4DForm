{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 500,
	"windowMinHeight": 350,
	"rightMargin": 20,
	"bottomMargin": 20,
	"windowTitle": "Recherche de patients",
	"destination": "detailScreen",
	"events": [
		"onLoad",
		"onDataChange",
		"onSelectionChange",
		"onDoubleClick"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"txtTitle": {
					"type": "text",
					"text": "Recherche de patients",
					"left": 20,
					"top": 20,
					"width": 250,
					"height": 24,
					"fontSize": 18,
					"fontWeight": "bold"
				},
				"bgSearch": {
					"type": "rectangle",
					"left": 20,
					"top": 60,
					"width": 760,
					"height": 34,
					"stroke": "#c0c0c0",
					"sizingX": "grow"
				},
				"inputSearch": {
					"type": "input",
					"left": 30,
					"top": 68,
					"width": 740,
					"height": 18,
					"placeholder": "Rechercher par prénom ou nom",
					"dataSource": "Form:C1466.handler.searchText",
					"events": [
						"onDataChange"
					],
					"fill": "transparent",
					"borderStyle": "none",
					"sizingX": "grow"
				},
				"lbPatients": {
					"type": "listbox",
					"left": 20,
					"top": 110,
					"width": 760,
					"height": 320,
					"events": [
						"onSelectionChange",
						"onDoubleClick"
					],
					"listboxType": "collection",
					"dataSource": "Form:C1466.handler.patients",
					"currentItemSource": "Form:C1466.handler.currentPatient",
					"selectionMode": "single",
					"sortable": false,
					"showHeaders": true,
					"headerHeight": "30px",
					"rowHeight": "26px",
					"scrollbarHorizontal": "automatic",
					"scrollbarVertical": "automatic",
					"sizingX": "grow",
					"sizingY": "grow",
					"columns": [
						{
							"header": {
								"text": "Dossier",
								"name": "headerFileNumber"
							},
							"name": "columnFileNumber",
							"width": 100,
							"dataSource": "This:C1470.NoDossier",
							"enterable": false,
							"horizontalPadding": 6,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer1"
							}
						},
						{
							"header": {
								"text": "Nom",
								"name": "headerLastName"
							},
							"name": "columnLastName",
							"width": 240,
							"dataSource": "This:C1470.Nom",
							"enterable": false,
							"horizontalPadding": 6,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer2"
							}
						},
						{
							"header": {
								"text": "Prénom",
								"name": "headerFirstName"
							},
							"name": "columnFirstName",
							"width": 240,
							"dataSource": "This:C1470.Prénom",
							"enterable": false,
							"horizontalPadding": 6,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer3"
							}
						},
						{
							"header": {
								"text": "Date de naissance",
								"name": "headerBirthDate"
							},
							"name": "columnBirthDate",
							"width": 160,
							"dataSource": "This:C1470[\"Date Naissance\"]",
							"dateFormat": "systemShort",
							"enterable": false,
							"horizontalPadding": 6,
							"verticalAlign": "middle",
							"footer": {
								"name": "Footer4"
							}
						}
					]
				},
				"bgCancel": {
					"type": "rectangle",
					"left": 360,
					"top": 450,
					"width": 200,
					"height": 30,
					"stroke": "#c0c0c0",
					"fill": "#E5E5E5",
					"sizingX": "move",
					"sizingY": "move"
				},
				"btnCancel": {
					"type": "button",
					"style": "custom",
					"borderStyle": "none",
					"text": "Annuler",
					"action": "cancel",
					"left": 360,
					"top": 450,
					"width": 200,
					"height": 30,
					"sizingX": "move",
					"sizingY": "move"
				},
				"bgSelect": {
					"type": "rectangle",
					"left": 580,
					"top": 450,
					"width": 200,
					"height": 30,
					"stroke": "#c0c0c0",
					"fill": "#C1F3A0",
					"sizingX": "move",
					"sizingY": "move"
				},
				"btnSelect": {
					"type": "button",
					"style": "custom",
					"borderStyle": "none",
					"text": "Sélectionner",
					"action": "accept",
					"left": 580,
					"top": 450,
					"width": 200,
					"height": 30,
					"sizingX": "move",
					"sizingY": "move"
				}
			}
		}
	],
	"geometryStamp": 5,
	"method": "method.4dm",
	"editor": {
		"groups": {
			"Group": [
				"bgCancel",
				"btnCancel"
			],
			"Group1": [
				"bgSelect",
				"btnSelect"
			]
		},
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	}
}
