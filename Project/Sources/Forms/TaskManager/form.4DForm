{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onClick",
		"onDataChange",
		"onPageChange"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"bgAddTaskButton": {
					"type": "rectangle",
					"top": 20,
					"left": 1270,
					"width": 30,
					"height": 30,
					"stroke": "#c0c0c0"
				},
				"inputTaskCounter": {
					"type": "input",
					"left": 1050,
					"top": 27,
					"width": 200,
					"height": 16,
					"placeholder": "Aucune tâche restante",
					"dataSource": "Form:C1466.handler.taskCounter",
					"enterable": false,
					"focusable": false,
					"fontWeight": "bold",
					"sizingX": "move",
					"fill": "transparent",
					"borderStyle": "none",
					"textAlign": "right"
				},
				"btnAddTask": {
					"type": "button",
					"style": "circular",
					"text": "➕",
					"left": 1270,
					"top": 20,
					"width": 30,
					"height": 30,
					"events": [
						"onClick"
					],
					"sizingX": "move"
				},
				"rdbAllTasks": {
					"type": "radio",
					"text": "Toutes les tâches",
					"left": 20,
					"top": 67,
					"width": 125,
					"height": 17,
					"radioGroup": "taskScope",
					"dataSource": "Form:C1466.handler.showAll",
					"events": [
						"onClick"
					]
				},
				"rdbMyTasks": {
					"type": "radio",
					"text": "Mes tâches à faire",
					"left": 165,
					"top": 67,
					"width": 131,
					"height": 17,
					"radioGroup": "taskScope",
					"dataSource": "Form:C1466.handler.onlyMine",
					"events": [
						"onClick"
					]
				},
				"rdbDelegatedTasks": {
					"type": "radio",
					"text": "Tâches que j'ai déléguées",
					"left": 316,
					"top": 67,
					"width": 175,
					"height": 17,
					"radioGroup": "taskScope",
					"dataSource": "Form:C1466.handler.onlyDelegated",
					"events": [
						"onClick"
					]
				},
				"chkTodayTasks": {
					"type": "checkbox",
					"text": "Tâches d'aujourd'hui",
					"left": 580,
					"top": 68,
					"width": 143,
					"height": 17,
					"dataSource": "Form:C1466.handler.onlyToday",
					"events": [
						"onClick"
					]
				},
				"chkCompletedTasks": {
					"type": "checkbox",
					"text": "Tâches terminées",
					"left": 743,
					"top": 68,
					"width": 127,
					"height": 17,
					"dataSource": "Form:C1466.handler.showCompleted",
					"events": [
						"onClick"
					]
				},
				"lbTasks": {
					"type": "listbox",
					"left": 20,
					"top": 105,
					"width": 1280,
					"height": 400,
					"events": [
						"onClick",
						"onHeaderClick",
						"onDataChange"
					],
					"listboxType": "collection",
					"dataSource": "Form:C1466.handler.tasks",
					"scrollbarHorizontal": "automatic",
					"scrollbarVertical": "automatic",
					"sizingX": "grow",
					"sizingY": "grow",
					"resizingMode": "legacy",
					"rowStrokeSource": "Form:C1466.handler.taskFontColor(This:C1470.completed_at#Null:C1517; This:C1470.is_urgent)",
					"rowStyleSource": "Form:C1466.handler.taskFontStyle(This:C1470.completed_at#Null:C1517; This:C1470.is_urgent)",
					"headerHeight": "34px",
					"rowHeight": "28px",
					"verticalLineStroke": "transparent",
					"rowHeightAutoMin": "1em",
					"rowHeightAutoMax": "1600em",
					"sortable": false,
					"showHeaders": false,
					"selectionMode": "single",
					"hideSystemHighlight": true,
					"currentItemSource": "Form:C1466.handler.currentTask",
					"bottom": 505,
					"columns": [
						{
							"header": {
								"text": "Statut",
								"name": "headerStatus"
							},
							"name": "columnStatus",
							"width": 75,
							"footer": {
								"name": "footerStatus"
							},
							"dataSource": "Form:C1466.handler.completionEmoji(This:C1470.completed_at#Null:C1517; This:C1470.is_urgent)",
							"horizontalPadding": 5,
							"verticalPadding": 5,
							"textAlign": "center",
							"verticalAlign": "middle",
							"rowHeightAuto": true,
							"wordwrap": "normal",
							"enterable": false,
							"fontSize": 18
						},
						{
							"header": {
								"text": "Tâche",
								"name": "headerTask"
							},
							"name": "columnTask",
							"footer": {
								"name": "footerTask"
							},
							"dataSource": "This:C1470.description",
							"horizontalPadding": 5,
							"verticalPadding": 5,
							"width": 512,
							"rowHeightAuto": true,
							"wordwrap": "normal",
							"verticalAlign": "middle",
							"textAlign": "center",
							"enterable": false
						},
						{
							"header": {
								"text": "Patient",
								"name": "headerPatient"
							},
							"name": "columnPatient",
							"width": 150,
							"footer": {
								"name": "footerPatient"
							},
