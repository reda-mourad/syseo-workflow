							},
							"name": "columnCategories",
							"width": 308,
							"footer": {
								"name": "footerCategories"
							},
							"dataSource": "This:C1470.taskTags.tag.label.join(\" + \")",
							"horizontalPadding": 5,
							"verticalPadding": 5,
							"rowHeightAuto": true,
							"wordwrap": "normal",
							"verticalAlign": "middle",
							"textAlign": "center",
							"enterable": false
						},
						{
