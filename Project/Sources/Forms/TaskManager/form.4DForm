							"horizontalPadding": 5,
							"verticalPadding": 5,
							"rowHeightAuto": true,
							"wordwrap": "normal",
							"verticalAlign": "middle",
							"textAlign": "center",
							"enterable": false
						},
						{
							"header": {
								"text": "Catégories",
