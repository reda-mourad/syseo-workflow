{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"events": [
		"onLoad",
		"onUnload",
		"onClick",
		"onSelectionChange"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"subformConversation": {
					"type": "subform",
					"left": 341,
					"top": 63,
					"width": 629,
					"height": 409,
					"right": 970,
					"bottom": 472,
					"dataSource": "Form:C1466.handler.conversationContext",
					"sizingX": "grow",
					"sizingY": "grow"
				},
				"txtConversationListTitle": {
					"type": "text",
					"text": "Mes conversations",
					"left": 20,
					"top": 20,
					"width": 152,
					"height": 22,
					"fontWeight": "bold",
					"fontSize": 18
				},
				"lbConversations": {
					"type": "listbox",
					"left": 20,
					"top": 63,
					"width": 280,
					"height": 355,
					"bottom": 418,
					"events": [
						"onSelectionChange"
					],
					"listboxType": "collection",
					"dataSource": "Form:C1466.handler.conversations",
					"rowStrokeSource": "Form:C1466.handler.conversationColor(This:C1470)",
