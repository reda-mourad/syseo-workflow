					"currentItemPositionSource": "Form:C1466.handler.selectedConversationPosition",
					"selectionMode": "single",
					"showHeaders": false,
					"rowHeight": "44px",
					"scrollbarHorizontal": "hidden",
					"scrollbarVertical": "automatic",
					"sizingY": "grow",
					"sizingX": "grow",
					"hideExtraBlankRows": true,
					"columns": [
						{
							"header": {
								"text": "Conversation",
								"name": "headerConversationTitle"
							},
							"footer": {
								"name": "footerConversationTitle"
							},
							"name": "columnConversationTitle",
							"width": 320,
							"dataSource": "Form:C1466.handler.conversationTitle(This:C1470)",
							"rowStyleSource": "Form:C1466.handler.conversationStyle(This:C1470)",
							"horizontalPadding": 5,
							"verticalPadding": 5,
							"verticalAlign": "middle",
							"wordwrap": "normal",
							"enterable": false
						}
					]
				},
				"bgNewConversation": {
					"type": "rectangle",
					"left": 20,
					"top": 438,
					"width": 280,
					"height": 34,
					"stroke": "#c0c0c0",
					"fill": "#C1F3A0",
					"sizingX": "grow",
					"sizingY": "move"
				},
				"btnNewConversation": {
					"type": "button",
					"style": "custom",
