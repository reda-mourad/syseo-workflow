					"left": 320,
					"top": 20,
					"width": 1,
					"height": 452,
					"bottom": 472,
					"stroke": "#c0c0c0",
					"sizingY": "grow",
					"borderStyle": "solid"
				},
				"inputConversationTitle": {
					"type": "input",
					"left": 341,
